{
  "name": "@darcbench/web",
  "version": "0.2.0",
  "private": true,
  "description": "DARCBench local dashboard. Built to apps/web/dist and embedded into the agent binary.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
